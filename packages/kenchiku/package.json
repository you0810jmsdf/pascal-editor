{
  "name": "@nsfactory/kenchiku",
  "version": "0.1.0",
  "description": "日本の木造住宅の壁量・柱小径計算と法規知識（Pascal 非依存）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && bun ../../scripts/fix-node-esm-imports.ts dist",
    "check-types": "tsgo --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/bun": "^1.3.0",
    "typescript": "6.0.3"
  },
  "license": "MIT"
}
